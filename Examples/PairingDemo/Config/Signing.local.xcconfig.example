// 이 파일을 Signing.local.xcconfig로 복사하고 개발 팀 ID를 넣는다.
// 팀 ID는 developer.apple.com > Account > Membership details의 Team ID(10자)다.
DEVELOPMENT_TEAM = XXXXXXXXXX

// 번들 ID 앞부분. 그 팀이 쓸 수 있는 값으로 바꾼다. 예: dev.<팀 ID 소문자>
DEMO_BUNDLE_PREFIX = dev.xxxxxxxxxx

// Mac 앱을 개발 인증서로 서명한다(선택). 넣지 않으면 임시 서명이다.
// DEMO_MAC_SIGN_IDENTITY = Apple Development
