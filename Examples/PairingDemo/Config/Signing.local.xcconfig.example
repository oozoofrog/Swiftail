// Copy this file to Signing.local.xcconfig and fill in the development team ID.
// Find the 10-character Team ID at developer.apple.com > Account > Membership details.
DEVELOPMENT_TEAM = XXXXXXXXXX

// Bundle ID prefix. Replace it with a value the team can use, such as dev.<lowercase team ID>.
DEMO_BUNDLE_PREFIX = dev.xxxxxxxxxx

// Sign the Mac app with a development certificate (optional). If omitted, the app uses ad hoc signing.
// DEMO_MAC_SIGN_IDENTITY = Apple Development
