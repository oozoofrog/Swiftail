// Signing settings for PairingDemo.
// Put personal values (development team ID and bundle ID prefix) in Signing.local.xcconfig in the same directory. Keep that file out of the repository.
// If the file is absent, the #include? line below is skipped. See Signing.local.xcconfig.example.

// Bundle ID prefix. The app uses $(DEMO_BUNDLE_PREFIX).PairingDemo. This value is a placeholder. To install on an iPhone,
// replace it in Signing.local.xcconfig with a value your team can use.
DEMO_BUNDLE_PREFIX = com.example.swiftail-demo

// Signing for the Mac app. The default is ad hoc signing (-) for running on this Mac only. Ad hoc signing makes each build appear to be a different app,
// so you must grant access to the OAuth client in the keychain after each rebuild.
DEMO_MAC_SIGN_IDENTITY = -

#include? "Signing.local.xcconfig"
